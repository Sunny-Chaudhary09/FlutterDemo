<?xml version="1.0" encoding="utf-8"?>
<GridLayout android:id="@+id/day_grid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="7"
    android:layout_marginTop="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    app:layout_constraintTop_toBottomOf="@id/day_headers"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_columnSpan="5"/>
    <TextView style="@style/CalendarDayNumberBase" android:text="1" />

    <TextView style="@style/CalendarDayNumberBase" android:text="2" />
    <TextView style="@style/CalendarDayNumberBase" android:text="3" />
    <TextView style="@style/CalendarDayNumberBase" android:text="4" />
    <TextView style="@style/CalendarDayNumberBase" android:text="5" />
    <TextView style="@style/CalendarDayNumberBase" android:text="6" />
    <TextView style="@style/CalendarDayNumberBase" android:text="7" />
    <TextView style="@style/CalendarDayNumberBase" android:text="8" />

    <TextView style="@style/CalendarDayNumberBase" android:text="9" />
    <TextView style="@style/CalendarDayNumberBase" android:text="10" />
    <TextView style="@style/CalendarDayNumberBase" android:text="11" />
    <TextView style="@style/CalendarDayNumberBase" android:text="12" />
    <TextView style="@style/CalendarDayNumberBase" android:text="13" />
    <TextView style="@style/CalendarDayNumberBase" android:text="14" />
    <TextView style="@style/CalendarDayNumberBase" android:text="15" />

    <TextView style="@style/CalendarDayNumberBase" android:text="16" />
    <TextView style="@style/CalendarDayNumberBase" android:text="17" />
    <TextView style="@style/CalendarDayNumberBase" android:text="18" />
    <TextView style="@style/CalendarDayNumberBase" android:text="19" />
    <TextView style="@style/CalendarDayNumberBase" android:text="20" />
    <TextView style="@style/CalendarDayNumberBase" android:text="21" />
    <TextView style="@style/CalendarDayNumberBase" android:text="22" />

    <TextView style="@style/CalendarDayNumberBase" android:text="23" />

    <TextView
        style="@style/CalendarDayNumberBase"
        android:text="24"
        android:textColor="@android:color/white"
        android:background="@drawable/shape_selected_day_24"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_columnWeight="1"/>

    <TextView
        style="@style/CalendarDayNumberBase"
        android:text="25"
        android:textColor="@android:color/white"
        android:background="#334285F4"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_columnWeight="1"/>

    <TextView style="@style/CalendarDayNumberBase" android:text="26" />
    <TextView style="@style/CalendarDayNumberBase" android:text="27" />
    <TextView style="@style/CalendarDayNumberBase" android:text="28" />
    <TextView style="@style/CalendarDayNumberBase" android:text="29" />

    <TextView style="@style/CalendarDayNumberBase" android:text="30" />
    <TextView style="@style/CalendarDayNumberBase" android:text="31" />

</GridLayout>