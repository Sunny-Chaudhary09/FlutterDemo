<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151421">

    <TextView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_arrow_back"
        android:drawablePadding="8dp"
        android:text="Back"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/cancel_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel date"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/stay_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2-night stay"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/stay_dates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mon, Oct 24 - Wed, Oct 26"
        android:textColor="#A0A0A0"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/stay_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/calendar_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#33FFFFFF"  app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/stay_dates"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="October 2022"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:id="@+id/day_headers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:layout_marginTop="24dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/month_title">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" android:text="SUN"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" android:text="MON"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" android:text="TUE"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" android:text="WED"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" android:text="THU"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" android:text="FRI"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" android:text="SAT"/>
            </LinearLayout>

            <GridLayout
                android:id="@+id/day_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:layout_marginTop="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/day_headers">

                <include layout="@layout/day_grid_row" />

                <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_columnSpan="5"/>
                <TextView style="@style/CalendarDayNumberBase" android:text="1" />

                <TextView style="@style/CalendarDayNumberBase" android:text="2" />
                <TextView style="@style/CalendarDayNumberBase" android:text="3" />
                <TextView style="@style/CalendarDayNumberBase" android:text="4" />
                <TextView style="@style/CalendarDayNumberBase" android:text="5" />
                <TextView style="@style/CalendarDayNumberBase" android:text="6" />
                <TextView style="@style/CalendarDayNumberBase" android:text="7" />
                <TextView style="@style/CalendarDayNumberBase" android:text="8" />

                <TextView style="@style/CalendarDayNumberBase" android:text="9" />
                <TextView style="@style/CalendarDayNumberBase" android:text="10" />
                <TextView style="@style/CalendarDayNumberBase" android:text="11" />
                <TextView style="@style/CalendarDayNumberBase" android:text="12" />
                <TextView style="@style/CalendarDayNumberBase" android:text="13" />
                <TextView style="@style/CalendarDayNumberBase" android:text="14" />
                <TextView style="@style/CalendarDayNumberBase" android:text="15" />

                <TextView style="@style/CalendarDayNumberBase" android:text="16" />
                <TextView style="@style/CalendarDayNumberBase" android:text="17" />
                <TextView style="@style/CalendarDayNumberBase" android:text="18" />
                <TextView style="@style/CalendarDayNumberBase" android:text="19" />
                <TextView style="@style/CalendarDayNumberBase" android:text="20" />
                <TextView style="@style/CalendarDayNumberBase" android:text="21" />
                <TextView style="@style/CalendarDayNumberBase" android:text="22" />

                <TextView style="@style/CalendarDayNumberBase" android:text="23" />

                <TextView style="@style/CalendarDayNumberBase" android:text="24" android:textColor="#4285F4" android:background="@drawable/shape_selected_day_24"/>

                <TextView style="@style/CalendarDayNumberBase" android:text="25" android:textColor="@android:color/white" android:background="#334285F4"/>

                <TextView style="@style/CalendarDayNumberBase" android:text="26" />
                <TextView style="@style/CalendarDayNumberBase" android:text="27" />
                <TextView style="@style/CalendarDayNumberBase" android:text="28" />
                <TextView style="@style/CalendarDayNumberBase" android:text="29" />

                <TextView style="@style/CalendarDayNumberBase" android:text="30" />
                <TextView style="@style/CalendarDayNumberBase" android:text="31" />

            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/day_grid">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_arrow_back_ios_small"
                    android:background="@drawable/shape_circular_background_dark"
                    android:padding="12dp"
                    android:tint="@android:color/white"
                    android:contentDescription="Previous month" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="1dp"
                    android:background="#22FFFFFF"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_arrow_forward_ios_small"
                    android:background="@drawable/shape_circular_background_dark"
                    android:padding="12dp"
                    android:tint="@android:color/white"
                    android:contentDescription="Next month" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#151421"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/price_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$200 CAD"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/night"
                        android:textColor="#A0A0A0"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/date_range_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/price_info"
                    android:layout_marginStart="16dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calendar_icon"
                        android:tint="#A0A0A0"
                        android:contentDescription="Date range icon"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oct 24 - 26"
                        android:textColor="#A0A0A0"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Select Date"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:backgroundTint="#4285F4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

